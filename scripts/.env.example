# Copy this file to scripts/.env and edit the values.
# DOMAIN must resolve to this server's public IP. www.DOMAIN must also resolve there.
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Used for the systemd service and Nginx site name.
APP_NAME=barcode-store-manager

# The Node app must listen on this port. Set PORT support in the app if needed.
APP_PORT=3000

# Adjust these to match package.json. The default assumes npm ci/build/start scripts exist.
INSTALL_COMMAND=npm install --legacy-peer-depsls
BUILD_COMMAND=npm run build
START_COMMAND=npm run start

# Node.js major version installed by the script.
NODE_MAJOR=22

# systemd user that runs the app. Ensure it can read the repo and access required files.
SERVICE_USER=www-data

# Change to yes only after reviewing settings and confirming DNS/firewall requirements.
CONFIRM_DEPLOY=no

SERVICE_USER=ryan
